# EBSP 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==============================================================================
# JWT 认证配置 (生产环境必填)
# ==============================================================================
# JWT 密钥 (生产环境必须设置，使用强随机字符串)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
EBSP_JWT_SECRET_KEY=your-secret-key-here-change-in-production

# ==============================================================================
# 数据库配置
# ==============================================================================
# 数据库连接 URL
# 开发环境: sqlite+aiosqlite:///./db/ebsp.db
# 生产环境: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./db/ebsp.db

# 是否输出 SQL 日志 (true/false)
DB_ECHO=false
